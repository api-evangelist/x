            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Look up a user by ID"
        },
        {
          "info": {
            "name": "Look up a user by username",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.x.com/2/users/by/username/:username",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Look up a user by username"
        }
      ]
    }
  ],
  "bundled": true
}